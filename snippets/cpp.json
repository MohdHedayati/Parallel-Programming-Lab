  "MPI 3b: Pi calculation (Bcast+Reduce)": {
    "prefix": "mpi3b",
    "description": "MPI 3b: Pi calculation (Bcast+Reduce)",
    "body": [
      "// Practical 3b: MPI - calculate Pi",
      "// Each process sums a share of the intervals; MPI_Reduce adds the partial results.",
      "// Compile: mpic++ 3b_pi_mpi.cpp -o 3b",
      "// Run:     mpirun -np 4 ./3b",
      "#include <iostream>",
      "#include <iomanip>",
      "#include <cmath>",
      "#include <mpi.h>",
      "",
      "int main(int argc, char* argv[]) {",
      "    const double PI25DT = 3.141592653589793238462643;",
      "    int n, myid, numprocs;",
      "",
      "    MPI_Init(&argc, &argv);",
      "    MPI_Comm_size(MPI_COMM_WORLD, &numprocs);",
      "    MPI_Comm_rank(MPI_COMM_WORLD, &myid);",
      "",
      "    while (true) {",
      "        if (myid == 0) {",
      "            std::cout << \"Enter the number of intervals: (0 quits) \" << std::flush;",
      "            std::cin >> n;",
      "        }",
      "",
      "        // Rank 0 sends n to every other process",
      "        MPI_Bcast(&n, 1, MPI_INT, 0, MPI_COMM_WORLD);",
      "",
      "        if (n == 0) break;",
      "",
      "        double h = 1.0 / n;",
      "        double sum = 0.0;",
      "",
      "        // Process k handles intervals k+1, k+1+numprocs, k+1+2*numprocs, ...",
      "        for (int i = myid + 1; i <= n; i += numprocs) {",
      "            double x = h * (i - 0.5);",
      "            sum += 4.0 / (1.0 + x * x);",
      "        }",
      "        double mypi = h * sum;",
      "",
      "        double pi;",
      "        MPI_Reduce(&mypi, &pi, 1, MPI_DOUBLE, MPI_SUM, 0, MPI_COMM_WORLD);",
      "",
      "        if (myid == 0) {",
      "            std::cout << std::fixed << std::setprecision(16)",
      "                      << \"pi is approximately \" << pi",
      "                      << \", Error is \" << std::fabs(pi - PI25DT) << std::endl;",
      "        }",
      "    }",
      "",
      "    MPI_Finalize();",
      "    return 0;",
      "}"
    ]
  },
  "MPI 3c: Scatter VJTI to 4 processes": {
    "prefix": "mpi3c",
    "description": "MPI 3c: Scatter VJTI to 4 processes",
    "body": [
      "// Practical 3c: MPI_Scatter - root (rank 0) sends \"VJTI\" to all 4 processes",
      "// Compile: mpic++ 3c_scatter.cpp -o 3c",
      "// Run:     mpirun -np 4 ./3c",
      "#include <iostream>",
      "#include <mpi.h>",
      "",
      "const int SIZE = 4;",
      "",
      "int main(int argc, char* argv[]) {",
      "    int numtasks, rank;",
      "",
      "    MPI_Init(&argc, &argv);",
      "    MPI_Comm_rank(MPI_COMM_WORLD, &rank);",
      "    MPI_Comm_size(MPI_COMM_WORLD, &numtasks);",
      "",
      "    if (numtasks == SIZE) {",
      "        // Only the root's send buffer matters. Row i goes to process i.",
      "        char sendbuf[SIZE][SIZE] = {",
      "            {'V', 'J', 'T', 'I'},",
      "            {'V', 'J', 'T', 'I'},",
      "            {'V', 'J', 'T', 'I'},",
      "            {'V', 'J', 'T', 'I'}",
      "        };",
      "        char recvbuf[SIZE];",
      "",
      "        MPI_Scatter(sendbuf, SIZE, MPI_CHAR,   // what root sends (SIZE chars per process)",
      "                    recvbuf, SIZE, MPI_CHAR,   // what each process receives",
      "                    0, MPI_COMM_WORLD);        // root = rank 0",
      "",
      "        std::cout << \"rank= \" << rank << \"  Results: \"",
      "                  << recvbuf[0] << \" \" << recvbuf[1] << \" \"",
      "                  << recvbuf[2] << \" \" << recvbuf[3] << std::endl;",
      "    } else if (rank == 0) {",
      "        std::cout << \"Must specify \" << SIZE << \" processors. Terminating.\" << std::endl;",
      "    }",
      "",
      "    MPI_Finalize();",
      "    return 0;",
      "}"
    ]
  },
  "MPI 3d: Reduce max of 6 values": {
    "prefix": "mpi3d",
    "description": "MPI 3d: Reduce max of 6 values",
    "body": [
      "// Practical 3d: MPI_Reduce - maximum of 6 integers using 6 processes",
      "// Each process owns one element; the maximum is collected at the root (rank 0).",
      "// Compile: mpic++ 3d_reduce_max.cpp -o 3d",
      "// Run:     mpirun -np 6 ./3d",
      "#include <iostream>",
      "#include <mpi.h>",
      "",
      "int main(int argc, char* argv[]) {",
      "    int rank, numtasks;",
      "    int array[6] = {100, 600, 300, 800, 250, 720};",
      "",
      "    MPI_Init(&argc, &argv);",
      "    MPI_Comm_rank(MPI_COMM_WORLD, &rank);",
      "    MPI_Comm_size(MPI_COMM_WORLD, &numtasks);",
      "",
      "    if (numtasks != 6) {",
      "        if (rank == 0)",
      "            std::cout << \"This program needs exactly 6 processes.\" << std::endl;",
      "        MPI_Finalize();",
      "        return 1;",
      "    }",
      "",
      "    int inputNumber = array[rank];",
      "    std::cout << \"Local Input for process \" << rank << \" is \" << inputNumber << std::endl;",
      "",
      "    int maxNumber;",
      "    MPI_Reduce(&inputNumber, &maxNumber, 1, MPI_INT, MPI_MAX, 0, MPI_COMM_WORLD);",
      "",
      "    if (rank == 0)",
      "        std::cout << \"Maximum of all is: \" << maxNumber << std::endl;",
      "",
      "    MPI_Finalize();",
      "    return 0;",
      "}"
    ]
  },
  "MPI 3e: Ring topology": {
    "prefix": "mpi3e",
    "description": "MPI 3e: Ring topology",
    "body": [
      "// Practical 3e: MPI - Ring topology",
      "// Rank 0 sends its rank to rank 1. Each process adds its own rank to the value it",
      "// receives and passes it on. The last process sends the final sum back to rank 0,",
      "// closing the ring. Final sum = 0 + 1 + ... + (p-1).",
      "// Compile: mpic++ 3e_ring_topology.cpp -o 3e",
      "// Run:     mpirun -np 4 ./3e",
      "#include <iostream>",
      "#include <mpi.h>",
      "",
      "int main(int argc, char* argv[]) {",
      "    int rank, numprocs;",
      "    MPI_Status status;",
      "",
      "    MPI_Init(&argc, &argv);",
      "    MPI_Comm_size(MPI_COMM_WORLD, &numprocs);",
      "    MPI_Comm_rank(MPI_COMM_WORLD, &rank);",
      "",
      "    if (numprocs == 1) {",
      "        std::cout << \"MyRank 0 Final SUM 0 (only one process, no ring)\" << std::endl;",
      "        MPI_Finalize();",
      "        return 0;",
      "    }",
      "",
      "    const int tag = 0;",
      "    int next = (rank + 1) % numprocs;             // neighbour to send to",
      "    int prev = (rank - 1 + numprocs) % numprocs;  // neighbour to receive from",
      "    int value, sum;",
      "",
      "    if (rank == 0) {",
      "        // Start the ring with our own rank, then wait for it to come back around",
      "        MPI_Send(&rank, 1, MPI_INT, next, tag, MPI_COMM_WORLD);",
      "        MPI_Recv(&sum, 1, MPI_INT, prev, tag, MPI_COMM_WORLD, &status);",
      "        std::cout << \"MyRank \" << rank << \" Final SUM \" << sum << std::endl;",
      "    } else {",
      "        MPI_Recv(&value, 1, MPI_INT, prev, tag, MPI_COMM_WORLD, &status);",
      "        sum = value + rank;",
      "        // For the last process, next == 0, which completes the ring",
      "        MPI_Send(&sum, 1, MPI_INT, next, tag, MPI_COMM_WORLD);",
      "    }",
      "",
      "    MPI_Finalize();",
      "    return 0;",
      "}"
    ]
  },
  "MPI+OpenMP 4: Hyperquicksort": {
    "prefix": "hqsort",
    "description": "MPI+OpenMP 4: Hyperquicksort",
    "body": [
      "// Practical 4: Parallel Hyperquicksort using MPI + OpenMP",
      "//",
      "//   1. Rank 0 generates 10,000,000 random integers.",
      "//   2. The data is divided equally among the MPI processes (4 processes -> 2.5M each).",
      "//   3. Hyperquicksort:",
      "//        a) every process sorts its own chunk (OpenMP task-parallel quicksort)",
      "//        b) for each hypercube dimension, from the highest bit to the lowest:",
      "//             - the root of the current subcube picks a pivot (median of its sorted data)",
      "//               and broadcasts it to the subcube",
      "//             - every process splits its sorted data into \"<= pivot\" and \"> pivot\"",
      "//             - partner processes (rank XOR 2^i) swap halves: the lower one keeps the",
      "//               small half and sends the large half, the upper one does the opposite",
      "//             - each process merges what it kept with what it received",
      "//      After log2(p) rounds, process 0 holds the smallest values, process p-1 the",
      "//      largest, and every process's data is sorted.",
      "//   4. Rank 0 gathers the result and checks it against a sequential std::sort.",
      "//",
      "// MPI handles communication between processes; OpenMP uses several threads inside",
      "// each process (for the local sort and for the verification).",
      "//",
      "// Compile: mpic++ -O2 -fopenmp 4_hyperquicksort.cpp -o 4_hyperquicksort",
      "// Run:     mpiexec -n 4 .\\\\4_hyperquicksort.exe [N] [threads_per_process]",
      "//          (number of processes must be a power of 2: 1, 2, 4, 8, ...)",
      "#include <iostream>",
      "#include <iomanip>",
      "#include <vector>",
      "#include <random>",
      "#include <algorithm>",
      "#include <cstdlib>",
      "#include <mpi.h>",
      "#include <omp.h>",
      "",
      "// ---------------------------------------------------------------------------",
      "// OpenMP task-parallel quicksort on a[lo, hi)",
      "// ---------------------------------------------------------------------------",
      "static void quickTask(int* a, long lo, long hi) {",
      "    const long CUTOFF = 50000;  // below this, plain std::sort is faster than making tasks",
      "    if (hi - lo <= CUTOFF) {",
      "        std::sort(a + lo, a + hi);",
      "        return;",
      "    }",
      "    // Three-way partition around the middle element: [< pivot][== pivot][> pivot]",
      "    int pivot = a[lo + (hi - lo) / 2];",
      "    int* m1 = std::partition(a + lo, a + hi, [pivot](int x) { return x < pivot; });",
      "    int* m2 = std::partition(m1, a + hi, [pivot](int x) { return x == pivot; });",
      "    long i1 = m1 - a, i2 = m2 - a;",
      "",
      "    #pragma omp task",
      "    quickTask(a, lo, i1);",
      "    #pragma omp task",
      "    quickTask(a, i2, hi);",
      "}",
      "",
      "static void parallelSort(std::vector<int>& v) {",
      "    if (v.size() < 2) return;",
      "    #pragma omp parallel",
      "    {",
      "        #pragma omp single nowait",
      "        quickTask(v.data(), 0, (long)v.size());",
      "    }  // implicit barrier: waits for all tasks",
      "}",
      "",
      "// ---------------------------------------------------------------------------",
      "int main(int argc, char* argv[]) {",
      "    // FUNNELED: only the main thread of each process makes MPI calls",
      "    int provided;",
      "    MPI_Init_thread(&argc, &argv, MPI_THREAD_FUNNELED, &provided);",
      "",
      "    int rank, size;",
      "    MPI_Comm_rank(MPI_COMM_WORLD, &rank);",
      "    MPI_Comm_size(MPI_COMM_WORLD, &size);",
      "",
      "    long N = (argc > 1) ? std::atol(argv[1]) : 10000000L;",
      "    int threads = (argc > 2) ? std::atoi(argv[2])",
      "                             : std::max(1, omp_get_num_procs() / size);",
      "    omp_set_num_threads(threads);",
      "",
      "    if ((size & (size - 1)) != 0 || N % size != 0) {",
      "        if (rank == 0)",
      "            std::cout << \"Need a power-of-2 number of processes dividing N evenly.\\\\n\";",
      "        MPI_Finalize();",
      "        return 1;",
      "    }",
      "    int dims = 0;",
      "    while ((1 << dims) < size) dims++;  // hypercube dimension = log2(size)",
      "    const int localN = (int)(N / size);",
      "",
      "    if (rank == 0)",
      "        std::cout << \"Hyperquicksort: N = \" << N << \", processes = \" << size",
      "                  << \", OpenMP threads per process = \" << threads",
      "                  << \", hypercube dimension = \" << dims << \"\\\\n\";",
      "",
      "    // ---- 1. Generate data on rank 0 ---------------------------------------",
      "    std::vector<int> all;  // only filled on rank 0",
      "    if (rank == 0) {",
      "        all.resize(N);",
      "        std::mt19937 gen(12345);",
      "        std::uniform_int_distribution<int> dist(0, 1000000000);",
      "        for (long i = 0; i < N; i++) all[i] = dist(gen);",
      "        std::cout << \"Generated \" << N << \" random integers.\\\\n\";",
      "    }",
      "",
      "    // Sequential baseline (rank 0 only) for correctness check and speedup",
      "    std::vector<int> expected;",
      "    double tSeq = 0;",
      "    if (rank == 0) {",
      "        expected = all;",
      "        double t0 = MPI_Wtime();",
      "        std::sort(expected.begin(), expected.end());",
      "        tSeq = MPI_Wtime() - t0;",
      "    }",
      "",
      "    // ---- 2. Divide data among the processes -------------------------------",
      "    std::vector<int> local(localN);",
      "    MPI_Barrier(MPI_COMM_WORLD);",
      "    double tScatter0 = MPI_Wtime();",
      "    MPI_Scatter(all.data(), localN, MPI_INT, local.data(), localN, MPI_INT, 0, MPI_COMM_WORLD);",
      "    double tScatter = MPI_Wtime() - tScatter0;",
      "",
      "    // ---- 3. Hyperquicksort ------------------------------------------------",
      "    MPI_Barrier(MPI_COMM_WORLD);",
      "    double tStart = MPI_Wtime();",
      "",
      "    // Step (a): sort the local chunk using all OpenMP threads",
      "    parallelSort(local);",
      "",
      "    // Step (b): one round per hypercube dimension, highest bit first",
      "    for (int i = dims - 1; i >= 0; i--) {",
      "        // Processes with the same (rank >> (i+1)) form the current subcube",
      "        MPI_Comm sub;",
      "        MPI_Comm_split(MPI_COMM_WORLD, rank >> (i + 1), rank, &sub);",
      "        int subRank;",
      "        MPI_Comm_rank(sub, &subRank);",
      "",
      "        // Subcube root picks the pivot = median of its sorted data",
      "        int pivot = 0;",
      "        if (subRank == 0 && !local.empty()) pivot = local[local.size() / 2];",
      "        MPI_Bcast(&pivot, 1, MPI_INT, 0, sub);",
      "        MPI_Comm_free(&sub);",
      "",
      "        // Split the sorted data: [0, split) <= pivot, [split, end) > pivot",
      "        long split = std::upper_bound(local.begin(), local.end(), pivot) - local.begin();",
      "",
      "        int partner = rank ^ (1 << i);",
      "        bool lower = ((rank >> i) & 1) == 0;",
      "",
      "        // Lower process keeps the small part and sends the large part; upper does the reverse",
      "        const int* keepPtr = lower ? local.data() : local.data() + split;",
      "        int keepCnt = (int)(lower ? split : (long)local.size() - split);",
      "        const int* sendPtr = lower ? local.data() + split : local.data();",
      "        int sendCnt = (int)(lower ? (long)local.size() - split : split);",
      "",
      "        // Exchange sizes, then the data itself",
      "        int recvCnt;",
      "        MPI_Sendrecv(&sendCnt, 1, MPI_INT, partner, 0, &recvCnt, 1, MPI_INT, partner, 0,",
      "                     MPI_COMM_WORLD, MPI_STATUS_IGNORE);",
      "        std::vector<int> recv(recvCnt);",
      "        MPI_Sendrecv(sendPtr, sendCnt, MPI_INT, partner, 1, recv.data(), recvCnt, MPI_INT, partner, 1,",
      "                     MPI_COMM_WORLD, MPI_STATUS_IGNORE);",
      "",
      "        // Merge the two sorted pieces into the new local array",
      "        std::vector<int> merged(keepCnt + recvCnt);",
      "        std::merge(keepPtr, keepPtr + keepCnt, recv.begin(), recv.end(), merged.begin());",
      "        local.swap(merged);",
      "    }",
      "",
      "    MPI_Barrier(MPI_COMM_WORLD);",
      "    double tLocal = MPI_Wtime() - tStart;",
      "    double tPar = 0;",
      "    MPI_Reduce(&tLocal, &tPar, 1, MPI_DOUBLE, MPI_MAX, 0, MPI_COMM_WORLD);",
      "",
      "    // ---- 4. Verify --------------------------------------------------------",
      "    // Each process checks its own piece is sorted, using OpenMP threads",
      "    int sortedLocal = 1;",
      "    long n = (long)local.size();",
      "    #pragma omp parallel for reduction(&& : sortedLocal)",
      "    for (long k = 1; k < n; k++)",
      "        sortedLocal = sortedLocal && (local[k - 1] <= local[k]);",
      "",
      "    // Collect the piece sizes (hyperquicksort does not guarantee equal sizes) and the data",
      "    int myCount = (int)local.size();",
      "    std::vector<int> counts(size), displs(size, 0);",
      "    MPI_Gather(&myCount, 1, MPI_INT, counts.data(), 1, MPI_INT, 0, MPI_COMM_WORLD);",
      "    for (int r = 1; r < size && rank == 0; r++) displs[r] = displs[r - 1] + counts[r - 1];",
      "",
      "    std::vector<int> result;",
      "    if (rank == 0) result.resize(N);",
      "    MPI_Gatherv(local.data(), myCount, MPI_INT, result.data(), counts.data(), displs.data(),",
      "                MPI_INT, 0, MPI_COMM_WORLD);",
      "",
      "    int allSorted = 0;",
      "    MPI_Reduce(&sortedLocal, &allSorted, 1, MPI_INT, MPI_MIN, 0, MPI_COMM_WORLD);",
      "",
      "    if (rank == 0) {",
      "        bool matches = (result == expected);  // identical to sequential sort => correct",
      "        std::cout << \"\\\\nElements per process after sorting:\";",
      "        for (int r = 0; r < size; r++) std::cout << \" P\" << r << \"=\" << counts[r];",
      "        std::cout << \"\\\\nFirst 10 sorted values:\";",
      "        for (int k = 0; k < 10 && k < N; k++) std::cout << \" \" << result[k];",
      "        std::cout << \"\\\\nLast 10 sorted values: \";",
      "        for (long k = std::max(0L, N - 10); k < N; k++) std::cout << \" \" << result[k];",
      "",
      "        std::cout << std::fixed << std::setprecision(4);",
      "        std::cout << \"\\\\n\\\\nEach piece sorted (checked in parallel): \" << (allSorted ? \"yes\" : \"NO\")",
      "                  << \"\\\\nMatches sequential std::sort:            \" << (matches ? \"yes\" : \"NO\")",
      "                  << \"\\\\n\\\\nScatter time:                 \" << tScatter << \" s\"",
      "                  << \"\\\\nParallel hyperquicksort time: \" << tPar << \" s\"",
      "                  << \"\\\\nSequential std::sort time:    \" << tSeq << \" s\"",
      "                  << \"\\\\nSpeedup (sequential/parallel): \" << std::setprecision(2) << tSeq / tPar << \"x\\\\n\";",
      "    }",
      "",
      "    MPI_Finalize();",
      "    return 0;",
      "}"
    ]
  },
  "Benchmark 2c: seq vs parallel matrix multiply": {
    "prefix": "bench2c",
    "description": "Benchmark 2c: seq vs parallel matrix multiply",
    "body": [
      "// Benchmark for 2c (Matrix Multiplication)",
      "//   Task 3: sequential vs parallel execution time",
      "// Compile: g++ -O2 -fopenmp bench_2c_matrix.cpp -o bench_2c",
      "// Run:     ./bench_2c",
      "#include <iostream>",
      "#include <iomanip>",
      "#include <vector>",
      "#include <random>",
      "#include <algorithm>",
      "#include <chrono>",
      "#include <omp.h>",
      "",
      "using Mat = std::vector<int>;  // n x n matrix stored in one flat array",
      "",
      "// Best (smallest) time of 3 runs, in seconds",
      "template <class F>",
      "double timeIt(F f) {",
      "    double best = 1e30;",
      "    for (int r = 0; r < 3; r++) {",
      "        auto t0 = std::chrono::steady_clock::now();",
      "        f();",
      "        best = std::min(best, std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());",
      "    }",
      "    return best;",
      "}",
      "",
      "void multiplySeq(const Mat& A, const Mat& B, Mat& C, int n) {",
      "    for (int i = 0; i < n; i++)",
      "        for (int j = 0; j < n; j++) {",
      "            int s = 0;",
      "            for (int k = 0; k < n; k++) s += A[i * n + k] * B[k * n + j];",
      "            C[i * n + j] = s;",
      "        }",
      "}",
      "",
      "void multiplyPar(const Mat& A, const Mat& B, Mat& C, int n, int threads) {",
      "    #pragma omp parallel for num_threads(threads) schedule(static)",
      "    for (int i = 0; i < n; i++)",
      "        for (int j = 0; j < n; j++) {",
      "            int s = 0;",
      "            for (int k = 0; k < n; k++) s += A[i * n + k] * B[k * n + j];",
      "            C[i * n + j] = s;",
      "        }",
      "}",
      "",
      "int main() {",
      "    const int threads = omp_get_max_threads();",
      "    std::mt19937 gen(42);",
      "    std::uniform_int_distribution<int> dist(0, 9);",
      "",
      "    std::cout << \"=== 2c Matrix Multiplication: sequential vs parallel (\" << threads",
      "              << \" threads) ===\\\\n\";",
      "    std::cout << std::left << std::setw(10) << \"Size\" << std::setw(16) << \"Sequential(s)\"",
      "              << std::setw(16) << \"Parallel(s)\" << std::setw(10) << \"Speedup\" << \"Correct\\\\n\";",
      "",
      "    for (int n : {100, 200, 400, 600, 800, 1000}) {",
      "        Mat A(n * n), B(n * n), C1(n * n), C2(n * n);",
      "        for (auto& x : A) x = dist(gen);",
      "        for (auto& x : B) x = dist(gen);",
      "",
      "        double ts = timeIt([&] { multiplySeq(A, B, C1, n); });",
      "        double tp = timeIt([&] { multiplyPar(A, B, C2, n, threads); });",
      "",
      "        std::cout << std::left << std::setw(10) << (std::to_string(n) + \"x\" + std::to_string(n))",
      "                  << std::fixed << std::setprecision(5) << std::setw(16) << ts << std::setw(16) << tp",
      "                  << std::setprecision(2) << std::setw(10) << ts / tp",
      "                  << (C1 == C2 ? \"yes\" : \"NO\") << \"\\\\n\";",
      "    }",
      "    return 0;",
      "}"
    ]
  },
  "Benchmark 2d: primes, threads/data/seq vs par": {
    "prefix": "bench2d",
    "description": "Benchmark 2d: primes, threads/data/seq vs par",
    "body": [
      "// Benchmark for 2d (Prime numbers between 2 and N, stored in an array)",
      "//   Task 1: same data (N), increasing threads",
      "//   Task 2: same threads, increasing data (N)",
      "//   Task 3: sequential vs parallel",
      "// Compile: g++ -O2 -fopenmp bench_2d_primes.cpp -o bench_2d",
      "// Run:     ./bench_2d",
      "#include <iostream>",
      "#include <iomanip>",
      "#include <vector>",
      "#include <algorithm>",
      "#include <chrono>",
      "#include <omp.h>",
      "",
      "template <class F>",
      "double timeIt(F f) {  // best of 3 runs, in seconds",
      "    double best = 1e30;",
      "    for (int r = 0; r < 3; r++) {",
      "        auto t0 = std::chrono::steady_clock::now();",
      "        f();",
      "        best = std::min(best, std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());",
      "    }",
      "    return best;",
      "}",
      "",
      "bool isPrime(int n) {",
      "    if (n < 2) return false;",
      "    for (int i = 2; (long long)i * i <= n; i++)",
      "        if (n % i == 0) return false;",
      "    return true;",
      "}",
      "",
      "// Sequential: test every number, append primes to the array",
      "size_t primesSeq(int N, std::vector<int>& out) {",
      "    out.clear();",
      "    for (int v = 2; v <= N; v++)",
      "        if (isPrime(v)) out.push_back(v);",
      "    return out.size();",
      "}",
      "",
      "// Parallel: every thread marks flag[v] (different cells, so no race),",
      "// then the primes are collected into the array in order.",
      "// schedule(dynamic) because large numbers take longer to test than small ones.",
      "size_t primesPar(int N, int threads, std::vector<char>& flag, std::vector<int>& out) {",
      "    flag.assign(N + 1, 0);",
      "    #pragma omp parallel for num_threads(threads) schedule(dynamic, 512)",
      "    for (int v = 2; v <= N; v++)",
      "        flag[v] = isPrime(v);",
      "    out.clear();",
      "    for (int v = 2; v <= N; v++)",
      "        if (flag[v]) out.push_back(v);",
      "    return out.size();",
      "}",
      "",
      "std::vector<int> threadCounts() {",
      "    int mx = omp_get_max_threads();",
      "    std::vector<int> t;",
      "    for (int k = 1; k < mx; k *= 2) t.push_back(k);",
      "    t.push_back(mx);",
      "    return t;",
      "}",
      "",
      "int main() {",
      "    const int maxThreads = omp_get_max_threads();",
      "    std::vector<int> out;",
      "    std::vector<char> flag;",
      "",
      "    // ---------- Task 1: fixed N, increasing threads ----------",
      "    const int N1 = 2000000;",
      "    std::cout << \"=== 2d Task 1: fixed N = \" << N1 << \", increasing threads ===\\\\n\";",
      "    double tSeq = timeIt([&] { primesSeq(N1, out); });",
      "    size_t expected = out.size();",
      "    std::cout << std::left << std::setw(10) << \"Threads\" << std::setw(14) << \"Time(s)\"",
      "              << std::setw(10) << \"Speedup\" << std::setw(12) << \"Efficiency\" << \"Primes found\\\\n\";",
      "    std::cout << std::setw(10) << \"seq\" << std::fixed << std::setprecision(4) << std::setw(14)",
      "              << tSeq << std::setw(10) << \"1.00\" << std::setw(12) << \"-\" << expected << \"\\\\n\";",
      "    for (int T : threadCounts()) {",
      "        size_t cnt = 0;",
      "        double t = timeIt([&] { cnt = primesPar(N1, T, flag, out); });",
      "        std::cout << std::setw(10) << T << std::setprecision(4) << std::setw(14) << t",
      "                  << std::setprecision(2) << std::setw(10) << tSeq / t << std::setw(12)",
      "                  << tSeq / t / T << cnt << (cnt == expected ? \"\" : \"  <-- MISMATCH\") << \"\\\\n\";",
      "    }",
      "",
      "    // ---------- Task 2 + 3: fixed threads, increasing N, sequential vs parallel ----------",
      "    std::cout << \"\\\\n=== 2d Task 2/3: fixed \" << maxThreads",
      "              << \" threads, increasing N (sequential vs parallel) ===\\\\n\";",
      "    std::cout << std::left << std::setw(12) << \"N\" << std::setw(14) << \"Seq(s)\" << std::setw(14)",
      "              << \"Par(s)\" << std::setw(10) << \"Speedup\" << \"Primes found\\\\n\";",
      "    for (int N : {100000, 250000, 500000, 1000000, 2000000, 4000000}) {",
      "        size_t a = 0, b = 0;",
      "        double ts = timeIt([&] { a = primesSeq(N, out); });",
      "        double tp = timeIt([&] { b = primesPar(N, maxThreads, flag, out); });",
      "        std::cout << std::left << std::setw(12) << N << std::fixed << std::setprecision(4)",
      "                  << std::setw(14) << ts << std::setw(14) << tp << std::setprecision(2)",
      "                  << std::setw(10) << ts / tp << a << (a == b ? \"\" : \"  <-- MISMATCH\") << \"\\\\n\";",
      "    }",
      "    return 0;",
      "}"
    ]
  },
  "Benchmark 2e: max, threads/data/seq vs par": {
    "prefix": "bench2e",
    "description": "Benchmark 2e: max, threads/data/seq vs par",
    "body": [
      "// Benchmark for 2e (Largest element in an array)",
      "//   Task 1: same data (n), increasing threads",
      "//   Task 2: same threads, increasing data (n)",
      "//   Task 3: sequential vs parallel",
      "// Compile: g++ -O2 -fopenmp bench_2e_max.cpp -o bench_2e",
      "// Run:     ./bench_2e",
      "#include <iostream>",
      "#include <iomanip>",
      "#include <vector>",
      "#include <random>",
      "#include <climits>",
      "#include <algorithm>",
      "#include <chrono>",
      "#include <omp.h>",
      "",
      "// Best of 5 runs (this task is very short, so use more repeats)",
      "template <class F>",
      "double timeIt(F f) {",
      "    double best = 1e30;",
      "    for (int r = 0; r < 5; r++) {",
      "        auto t0 = std::chrono::steady_clock::now();",
      "        f();",
      "        best = std::min(best, std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());",
      "    }",
      "    return best;",
      "}",
      "",
      "int maxSeq(const std::vector<int>& a, long n) {",
      "    int m = INT_MIN;",
      "    for (long i = 0; i < n; i++)",
      "        if (a[i] > m) m = a[i];",
      "    return m;",
      "}",
      "",
      "int maxPar(const std::vector<int>& a, long n, int threads) {",
      "    int m = INT_MIN;",
      "    #pragma omp parallel for num_threads(threads) reduction(max : m)",
      "    for (long i = 0; i < n; i++)",
      "        if (a[i] > m) m = a[i];",
      "    return m;",
      "}",
      "",
      "std::vector<int> threadCounts() {",
      "    int mx = omp_get_max_threads();",
      "    std::vector<int> t;",
      "    for (int k = 1; k < mx; k *= 2) t.push_back(k);",
      "    t.push_back(mx);",
      "    return t;",
      "}",
      "",
      "int main() {",
      "    const int maxThreads = omp_get_max_threads();",
      "    const long BIG = 100000000;  // 100 million ints (~400 MB)",
      "",
      "    std::vector<int> a(BIG);",
      "    std::mt19937 gen(1);",
      "    std::uniform_int_distribution<int> dist(-1000000000, 1000000000);",
      "    for (auto& x : a) x = dist(gen);",
      "",
      "    volatile int sink;  // stops the compiler from deleting the work",
      "",
      "    // ---------- Task 1: fixed n, increasing threads ----------",
      "    std::cout << \"=== 2e Task 1: fixed n = \" << BIG << \", increasing threads ===\\\\n\";",
      "    int expected = 0;",
      "    double tSeq = timeIt([&] { expected = maxSeq(a, BIG); sink = expected; });",
      "    std::cout << std::left << std::setw(10) << \"Threads\" << std::setw(14) << \"Time(s)\"",
      "              << std::setw(10) << \"Speedup\" << \"Efficiency\\\\n\";",
      "    std::cout << std::setw(10) << \"seq\" << std::fixed << std::setprecision(5) << std::setw(14)",
      "              << tSeq << std::setw(10) << \"1.00\" << \"-\\\\n\";",
      "    for (int T : threadCounts()) {",
      "        int r = 0;",
      "        double t = timeIt([&] { r = maxPar(a, BIG, T); sink = r; });",
      "        std::cout << std::setw(10) << T << std::setprecision(5) << std::setw(14) << t",
      "                  << std::setprecision(2) << std::setw(10) << tSeq / t << tSeq / t / T",
      "                  << (r == expected ? \"\" : \"  <-- MISMATCH\") << \"\\\\n\";",
      "    }",
      "",
      "    // ---------- Task 2 + 3: fixed threads, increasing n, sequential vs parallel ----------",
      "    std::cout << \"\\\\n=== 2e Task 2/3: fixed \" << maxThreads",
      "              << \" threads, increasing n (sequential vs parallel) ===\\\\n\";",
      "    std::cout << std::left << std::setw(14) << \"n\" << std::setw(14) << \"Seq(s)\" << std::setw(14)",
      "              << \"Par(s)\" << \"Speedup\\\\n\";",
      "    for (long n : {1000L, 10000L, 100000L, 1000000L, 10000000L, 100000000L}) {",
      "        int x = 0, y = 0;",
      "        double ts = timeIt([&] { x = maxSeq(a, n); sink = x; });",
      "        double tp = timeIt([&] { y = maxPar(a, n, maxThreads); sink = y; });",
      "        std::cout << std::left << std::setw(14) << n << std::fixed << std::setprecision(6)",
      "                  << std::setw(14) << ts << std::setw(14) << tp << std::setprecision(2)",
      "                  << ts / tp << (x == y ? \"\" : \"  <-- MISMATCH\") << \"\\\\n\";",
      "    }",
      "    return 0;",
      "}"
    ]
  },
  "Benchmark 2f: pi, threads/data/seq vs par": {
    "prefix": "bench2f",
    "description": "Benchmark 2f: pi, threads/data/seq vs par",
    "body": [
      "// Benchmark for 2f (Pi calculation)",
      "//   Task 1: same data (steps), increasing threads",
      "//   Task 2: same threads, increasing data (steps)",
      "//   Task 3: sequential vs parallel",
      "// Compile: g++ -O2 -fopenmp bench_2f_pi.cpp -o bench_2f",
      "// Run:     ./bench_2f",
      "#include <iostream>",
      "#include <iomanip>",
      "#include <vector>",
      "#include <cmath>",
      "#include <algorithm>",
      "#include <chrono>",
      "#include <omp.h>",
      "",
      "template <class F>",
      "double timeIt(F f) {  // best of 3 runs, in seconds",
      "    double best = 1e30;",
      "    for (int r = 0; r < 3; r++) {",
      "        auto t0 = std::chrono::steady_clock::now();",
      "        f();",
      "        best = std::min(best, std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());",
      "    }",
      "    return best;",
      "}",
      "",
      "double piSeq(long steps) {",
      "    double step = 1.0 / steps, sum = 0.0;",
      "    for (long i = 0; i < steps; i++) {",
      "        double x = (i + 0.5) * step;",
      "        sum += 4.0 / (1.0 + x * x);",
      "    }",
      "    return step * sum;",
      "}",
      "",
      "double piPar(long steps, int threads) {",
      "    double step = 1.0 / steps, sum = 0.0;",
      "    #pragma omp parallel for num_threads(threads) reduction(+ : sum) schedule(static)",
      "    for (long i = 0; i < steps; i++) {",
      "        double x = (i + 0.5) * step;",
      "        sum += 4.0 / (1.0 + x * x);",
      "    }",
      "    return step * sum;",
      "}",
      "",
      "std::vector<int> threadCounts() {",
      "    int mx = omp_get_max_threads();",
      "    std::vector<int> t;",
      "    for (int k = 1; k < mx; k *= 2) t.push_back(k);",
      "    t.push_back(mx);",
      "    return t;",
      "}",
      "",
      "int main() {",
      "    const int maxThreads = omp_get_max_threads();",
      "    volatile double sink;",
      "",
      "    // ---------- Task 1: fixed steps, increasing threads ----------",
      "    const long S1 = 400000000;",
      "    std::cout << \"=== 2f Task 1: fixed steps = \" << S1 << \", increasing threads ===\\\\n\";",
      "    double pi = 0;",
      "    double tSeq = timeIt([&] { pi = piSeq(S1); sink = pi; });",
      "    std::cout << std::left << std::setw(10) << \"Threads\" << std::setw(14) << \"Time(s)\"",
      "              << std::setw(10) << \"Speedup\" << std::setw(12) << \"Efficiency\" << \"Pi\\\\n\";",
      "    std::cout << std::setw(10) << \"seq\" << std::fixed << std::setprecision(4) << std::setw(14)",
      "              << tSeq << std::setw(10) << \"1.00\" << std::setw(12) << \"-\" << std::setprecision(10)",
      "              << pi << \"\\\\n\";",
      "    for (int T : threadCounts()) {",
      "        double p = 0;",
      "        double t = timeIt([&] { p = piPar(S1, T); sink = p; });",
      "        std::cout << std::setw(10) << T << std::setprecision(4) << std::setw(14) << t",
      "                  << std::setprecision(2) << std::setw(10) << tSeq / t << std::setw(12)",
      "                  << tSeq / t / T << std::setprecision(10) << p << \"\\\\n\";",
      "    }",
      "",
      "    // ---------- Task 2 + 3: fixed threads, increasing steps, sequential vs parallel ----------",
      "    std::cout << \"\\\\n=== 2f Task 2/3: fixed \" << maxThreads",
      "              << \" threads, increasing steps (sequential vs parallel) ===\\\\n\";",
      "    std::cout << std::left << std::setw(14) << \"Steps\" << std::setw(14) << \"Seq(s)\" << std::setw(14)",
      "              << \"Par(s)\" << std::setw(10) << \"Speedup\" << \"Pi (parallel)\\\\n\";",
      "    for (long s : {10000L, 100000L, 1000000L, 10000000L, 100000000L, 400000000L}) {",
      "        double a = 0, b = 0;",
      "        double ts = timeIt([&] { a = piSeq(s); sink = a; });",
      "        double tp = timeIt([&] { b = piPar(s, maxThreads); sink = b; });",
      "        std::cout << std::left << std::setw(14) << s << std::fixed << std::setprecision(6)",
      "                  << std::setw(14) << ts << std::setw(14) << tp << std::setprecision(2)",
      "                  << std::setw(10) << ts / tp << std::setprecision(10) << b << \"\\\\n\";",
      "    }",
      "    return 0;",
      "}"
    ]
  }
}