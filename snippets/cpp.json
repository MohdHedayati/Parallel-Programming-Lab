{
  "OpenMP 2a: Fork-Join model": {
    "prefix": "omp2a",
    "description": "OpenMP 2a: Fork-Join model",
    "body": [
      "// Practical 2a: OpenMP Fork-Join model",
      "// Compile: g++ -fopenmp 2a_fork_join.cpp -o 2a",
      "#include <iostream>",
      "#include <omp.h>",
      "",
      "int main() {",
      "    // Only the master thread exists here.",
      "    std::cout << \"Before parallel region: 1 thread (master)\\\\n\";",
      "",
      "    // FORK: a team of threads is created. Each thread gets its own copy of tid.",
      "    #pragma omp parallel",
      "    {",
      "        int tid = omp_get_thread_num();",
      "",
      "        // critical: only one thread prints at a time, so output is not garbled",
      "        #pragma omp critical",
      "        std::cout << \"Hello World from thread = \" << tid << \"\\\\n\";",
      "",
      "        // Only the master thread (id 0) does this",
      "        if (tid == 0) {",
      "            #pragma omp critical",
      "            std::cout << \"Number of threads = \" << omp_get_num_threads() << \"\\\\n\";",
      "        }",
      "    }   // JOIN: all threads merge back into the master thread",
      "",
      "    std::cout << \"After parallel region: back to 1 thread (master)\\\\n\";",
      "    return 0;",
      "}"
    ]
  },
  "OpenMP 2b: Producer-Consumer": {
    "prefix": "omp2b",
    "description": "OpenMP 2b: Producer-Consumer",
    "body": [
      "// Practical 2b: OpenMP Producer-Consumer",
      "// Thread 0 (master) is the producer. All other threads are consumers that wait",
      "// until the producer has filled the buffer, then consume from it.",
      "// Compile: g++ -fopenmp 2b_producer_consumer.cpp -o 2b",
      "#include <iostream>",
      "#include <atomic>",
      "#include <omp.h>",
      "",
      "int main() {",
      "    int buffer = 0;                  // shared \"data available\" counter",
      "    std::atomic<bool> ready(false);  // flag set by producer when data is ready",
      "",
      "    omp_set_num_threads(4);",
      "",
      "    #pragma omp parallel shared(buffer, ready)",
      "    {",
      "        int tid = omp_get_thread_num();",
      "",
      "        if (tid == 0) {",
      "            // ---- Producer ----",
      "            #pragma omp critical",
      "            {",
      "                std::cout << \"Producer (thread \" << tid << \") is adding data to the buffer\\\\n\";",
      "                buffer += 10;",
      "            }",
      "            ready = true;  // notify consumers",
      "        } else {",
      "            // ---- Consumer ----",
      "            while (!ready) {",
      "                // busy-wait until producer signals (no printing, to avoid flooding output)",
      "            }",
      "",
      "            #pragma omp critical",
      "            {",
      "                if (buffer > 0) {",
      "                    buffer -= 5;",
      "                    std::cout << \"Consumer (thread \" << tid << \") consumed data. Buffer left = \"",
      "                              << buffer << \"\\\\n\";",
      "                } else {",
      "                    std::cout << \"Consumer (thread \" << tid << \") found no data\\\\n\";",
      "                }",
      "            }",
      "        }",
      "    }",
      "",
      "    std::cout << \"Final buffer value = \" << buffer << \"\\\\n\";",
      "    return 0;",
      "}"
    ]
  },
  "OpenMP 2c: Matrix multiplication": {
    "prefix": "omp2c",
    "description": "OpenMP 2c: Matrix multiplication",
    "body": [
      "// Practical 2c: OpenMP Matrix Multiplication  (C = A x B)",
      "// Compile: g++ -fopenmp 2c_matrix_multiplication.cpp -o 2c",
      "#include <iostream>",
      "#include <vector>",
      "#include <omp.h>",
      "",
      "using Matrix = std::vector<std::vector<int>>;",
      "",
      "int main() {",
      "    int m, n, p;",
      "    std::cout << \"Enter the number of rows in Matrix 1: \";",
      "    std::cin >> m;",
      "    std::cout << \"Enter the number of columns in Matrix 1 (= rows in Matrix 2): \";",
      "    std::cin >> n;",
      "    std::cout << \"Enter the number of columns in Matrix 2: \";",
      "    std::cin >> p;",
      "",
      "    Matrix A(m, std::vector<int>(n));",
      "    Matrix B(n, std::vector<int>(p));",
      "    Matrix C(m, std::vector<int>(p, 0));",
      "",
      "    std::cout << \"<-- Input matrix 1 row-wise -->\\\\n\";",
      "    for (int i = 0; i < m; i++)",
      "        for (int j = 0; j < n; j++)",
      "            std::cin >> A[i][j];",
      "",
      "    std::cout << \"<-- Input matrix 2 row-wise -->\\\\n\";",
      "    for (int i = 0; i < n; i++)",
      "        for (int j = 0; j < p; j++)",
      "            std::cin >> B[i][j];",
      "",
      "    // Rows of C are divided among the threads. Loop variables declared inside",
      "    // the loop are automatically private to each thread.",
      "    #pragma omp parallel for schedule(static)",
      "    for (int i = 0; i < m; i++) {",
      "        for (int j = 0; j < p; j++) {",
      "            int sum = 0;",
      "            for (int k = 0; k < n; k++)",
      "                sum += A[i][k] * B[k][j];",
      "            C[i][j] = sum;",
      "        }",
      "    }",
      "",
      "    std::cout << \"The output after Matrix Multiplication is:\\\\n\";",
      "    for (int i = 0; i < m; i++) {",
      "        for (int j = 0; j < p; j++)",
      "            std::cout << C[i][j] << \"\\\\t\";",
      "        std::cout << \"\\\\n\";",
      "    }",
      "    return 0;",
      "}"
    ]
  },
  "OpenMP 2d: Prime numbers up to N": {
    "prefix": "omp2d",
    "description": "OpenMP 2d: Prime numbers up to N",
    "body": [
      "// Practical 2d: OpenMP - find primes between 2 and N and store them in an array",
      "// Compile: g++ -fopenmp 2d_prime_numbers.cpp -o 2d",
      "#include <iostream>",
      "#include <vector>",
      "#include <algorithm>",
      "#include <omp.h>",
      "",
      "bool isPrime(int number) {",
      "    if (number < 2) return false;",
      "    for (int i = 2; i * i <= number; i++)",
      "        if (number % i == 0) return false;",
      "    return true;",
      "}",
      "",
      "int main() {",
      "    int numThreads, N;",
      "    std::cout << \"Enter the number of threads: \";",
      "    std::cin >> numThreads;",
      "    std::cout << \"Enter the value of N: \";",
      "    std::cin >> N;",
      "",
      "    omp_set_num_threads(numThreads);",
      "",
      "    std::vector<int> primes;  // shared result array",
      "",
      "    #pragma omp parallel for",
      "    for (int value = 2; value <= N; value++) {",
      "        if (isPrime(value)) {",
      "            // Many threads writing to one vector at once would be a race",
      "            // condition, so only one thread at a time may add to it.",
      "            #pragma omp critical",
      "            primes.push_back(value);",
      "        }",
      "    }",
      "",
      "    // Threads finish in arbitrary order, so sort to get a clean output.",
      "    std::sort(primes.begin(), primes.end());",
      "",
      "    std::cout << \"Number of prime numbers between 2 and \" << N << \": \" << primes.size() << \"\\\\n\";",
      "    std::cout << \"Primes: \";",
      "    for (int p : primes) std::cout << p << \" \";",
      "    std::cout << \"\\\\n\";",
      "    return 0;",
      "}"
    ]
  },
  "OpenMP 2e: Largest element in array": {
    "prefix": "omp2e",
    "description": "OpenMP 2e: Largest element in array",
    "body": [
      "// Practical 2e: OpenMP - largest element in an array",
      "// Compile: g++ -fopenmp 2e_largest_element.cpp -o 2e",
      "#include <iostream>",
      "#include <vector>",
      "#include <climits>",
      "#include <omp.h>",
      "",
      "int main() {",
      "    int n;",
      "    std::cout << \"Enter the number of elements: \";",
      "    std::cin >> n;",
      "",
      "    std::vector<int> arr(n);",
      "    std::cout << \"Enter the elements:\\\\n\";",
      "    for (int i = 0; i < n; i++)",
      "        std::cin >> arr[i];",
      "",
      "    int currentMax = INT_MIN;",
      "",
      "    // reduction(max:...) gives each thread its own private max, then combines",
      "    // them at the end. No critical section is needed, so it runs truly in parallel.",
      "    #pragma omp parallel for reduction(max : currentMax)",
      "    for (int i = 0; i < n; i++) {",
      "        if (arr[i] > currentMax)",
      "            currentMax = arr[i];",
      "    }",
      "",
      "    std::cout << \"The Maximum Element is: \" << currentMax << \"\\\\n\";",
      "    return 0;",
      "}"
    ]
  },
  "OpenMP 2f: Pi calculation": {
    "prefix": "omp2f",
    "description": "OpenMP 2f: Pi calculation",
    "body": [
      "// Practical 2f: OpenMP - calculate Pi",
      "// Pi = integral from 0 to 1 of 4/(1+x^2) dx, approximated with the midpoint rule.",
      "// Compile: g++ -fopenmp 2f_pi_calculation.cpp -o 2f",
      "#include <iostream>",
      "#include <iomanip>",
      "#include <omp.h>",
      "",
      "int main() {",
      "    const int numSteps = 10000;",
      "    const double step = 1.0 / numSteps;",
      "    double sum = 0.0;",
      "",
      "    // reduction(+:sum): each thread keeps a private partial sum; they are added",
      "    // together when the loop ends. Faster than a critical section on every step.",
      "    #pragma omp parallel for reduction(+ : sum) schedule(static)",
      "    for (int i = 0; i < numSteps; i++) {",
      "        double x = (i + 0.5) * step;",
      "        sum += 4.0 / (1.0 + x * x);",
      "    }",
      "",
      "    double pi = step * sum;",
      "    std::cout << std::fixed << std::setprecision(10);",
      "    std::cout << \"The Value of PI is \" << pi << \"\\\\n\";",
      "    return 0;",
      "}"
    ]
  },
